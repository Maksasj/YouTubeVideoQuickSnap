{
  "manifest_version": 3,
  "name": "YouTube Video QuickSnap",
  "version": "1.0.0",
  "description": "Adds a button to the YouTube player that saves the current video frame as a full-resolution PNG.",
  "permissions": ["downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
